# ---- Aura API (services/api) ----
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
API_PORT=4000
# PORT is injected by the host (Render) and takes precedence over API_PORT.
# PORT=
# Proxy hops to trust. 1 on Render (TLS terminated upstream), 0 locally.
TRUST_PROXY_HOPS=0
# Comma-separated allow-list. Wildcards supported for Vercel preview domains:
# https://aura.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:5173

# Neon (Serverless PostgreSQL). Leave empty to boot without a DB (health will
# report database: disconnected). Example:
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=
# auto | require | disable — 'auto' enables TLS for any non-local host.
DATABASE_SSL=auto
# Apply pending Drizzle migrations at boot (Render free plan has no pre-deploy
# hook). Forward-only and idempotent; seeding is never automatic.
RUN_MIGRATIONS_ON_START=false

# JWT (Sprint 1)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LiveKit (Sprint 3)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=15m

# Conversation safety
CONVERSATION_MAX_DURATION_MINUTES=30
CONVERSATION_MAX_CONCURRENT_SESSIONS=1

# Companion LLM runtime
# Keep demo for offline development. Use openai_compatible for hosted vendors
# or local runtimes that expose /v1/chat/completions (vLLM, Ollama, LM Studio).
# Free-tier hosted options that speak the same protocol (no billing required,
# key still needed): Groq https://api.groq.com/openai/v1,
# OpenRouter https://openrouter.ai/api/v1 (models suffixed :free),
# Google AI Studio https://generativelanguage.googleapis.com/v1beta/openai
LLM_PROVIDER=demo
LLM_MODEL=aura-demo-1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=300
LLM_TEMPERATURE=0.7
LLM_COST_PER_1K_INPUT_MICRO_USD=0
LLM_COST_PER_1K_OUTPUT_MICRO_USD=0
