# ---- Aura API (services/api) ----
# Copy to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Neon (Serverless PostgreSQL). Leave empty to boot without a DB (health will
# report database: disconnected). Example:
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# JWT (Sprint 1)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
