# Aura-Backend environment
NODE_ENV=development
API_PORT=4000
# PORT is injected by the host (Render) and overrides API_PORT when present.
# PORT=
# Number of proxy hops to trust. Set to 1 on Render/behind a CDN, 0 locally.
TRUST_PROXY_HOPS=0
# Comma-separated allow-list. Wildcards are supported for preview domains,
# e.g. https://aura.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=
# auto | require | disable — 'auto' enables TLS for any non-local host.
DATABASE_SSL=auto
# Apply pending Drizzle migrations at boot (used on Render's free plan, which
# has no pre-deploy hook). Forward-only and idempotent.
RUN_MIGRATIONS_ON_START=false
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=15m
CONVERSATION_MAX_DURATION_MINUTES=30
CONVERSATION_MAX_CONCURRENT_SESSIONS=1
# LLM provider registry (unchanged architecture): demo | openai_compatible | none
LLM_PROVIDER=demo
LLM_MODEL=aura-demo-1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
MODERATION_PROVIDER=rules