# ---- Aura root environment example ----
# Copy to .env and fill in real values. NEVER commit .env.

# Neon (Serverless PostgreSQL) connection string
# Get this from your Neon dashboard. Example:
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# Backend API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT (Sprint 1 — Authentication)
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Realtime (Sprint 3 — Conversation)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=15m

# Session safety limits
CONVERSATION_MAX_DURATION_MINUTES=30
CONVERSATION_MAX_CONCURRENT_SESSIONS=1

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000
